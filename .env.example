# Database
DATABASE_URL=postgresql://agroplan:agroplan@db:5432/agroplan
# Optional: separate direct connection for Alembic migrations (no pooling)
# MIGRATION_DATABASE_URL=postgresql://agroplan:agroplan@db:5432/agroplan

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com

# ML Data & Models
ML_DATA_PATH=./data
ML_MODELS_PATH=./models

# Hugging Face (model artifacts)
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL_REPO_ZONING=SRBOTOM/agroplan-zonificacion
HF_MODEL_REPO_YIELD=SRBOTOM/agroplan-rendimiento
HF_MODEL_REVISION=main
# mvp = download only files required for production endpoints (default, recommended for Oracle Free Tier)
# all = download the entire HF repo
# none = skip HF downloads and use local files only
HF_DOWNLOAD_MODE=mvp

# LLM Configuration
# LLM_PROVIDER only affects the starting point of the round-robin.
# Accepts: openrouter, groq, or any value (all configured providers are used).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Comma-separated list of OpenRouter models. Free tier models end with :free
OPENROUTER_MODELS=google/gemini-2.0-flash:free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat:free,meta-llama/llama-3.1-8b-instruct:free
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mistral-saba-24b
LLM_TIMEOUT_SECONDS=30

# Admin API Key (protects admin endpoints)
ADMIN_API_KEY=

# Cache Configuration
CACHE_TTL_STRATEGY=end_of_month_bogota

# Logging
# DEBUG shows step-by-step logs for every endpoint, DB query, ML inference, and LLM call.
# INFO (default) shows high-level request/response and model events.
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Climate Sync Job (Open-Meteo)
ENABLE_CLIMATE_SYNC=true
CLIMATE_SYNC_HOUR=3
CLIMATE_SYNC_MINUTE=0
CLIMATE_SYNC_BATCH_SIZE=100
CLIMATE_SYNC_DELAY_SECONDS=2.0
CLIMATE_SYNC_DAYS_AHEAD=16
CLIMATE_SYNC_CLEANUP_DAYS=180
