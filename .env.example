# Database
DATABASE_URL=postgresql://agroplan:agroplan@db:5432/agroplan

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com

# ML Data Path (path to agroplan-colombia processed data)
ML_DATA_PATH=c:/Repositorios/Datos abiertos/agroplan-colombia/3_data_preparation/data/processed

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Climate Sync Job (Open-Meteo)
ENABLE_CLIMATE_SYNC=true
CLIMATE_SYNC_HOUR=3
CLIMATE_SYNC_MINUTE=0
CLIMATE_SYNC_BATCH_SIZE=100
CLIMATE_SYNC_DELAY_SECONDS=2.0
CLIMATE_SYNC_DAYS_AHEAD=90
CLIMATE_SYNC_CLEANUP_DAYS=180
