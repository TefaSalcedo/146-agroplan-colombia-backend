# Database
DATABASE_URL=postgresql://agroplan:agroplan@db:5432/agroplan
# Optional: separate direct connection for Alembic migrations (no pooling)
# MIGRATION_DATABASE_URL=postgresql://agroplan:agroplan@db:5432/agroplan

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com
# Retry configuration for transient DNS/network failures
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_RETRY_BACKOFF_BASE=1.0

# ML Data & Models
ML_DATA_PATH=./data
ML_MODELS_PATH=./models

# Hugging Face (model artifacts)
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL_REPO_ZONING=SRBOTOM/agroplan-zonificacion
HF_MODEL_REPO_YIELD=SRBOTOM/agroplan-rendimiento
HF_MODEL_REVISION=main
# mvp = download only files required for production endpoints (default, recommended for Oracle Free Tier)
# all = download the entire HF repo
# none = skip HF downloads and use local files only
HF_DOWNLOAD_MODE=mvp

# LLM Configuration
# Set LLM_ENABLED=false for controlled local tests. In that mode no LLM call,
# LLM audit row, AI guide cache row, or crop recommendation cache row is created.
# Default: true.
LLM_ENABLED=true
# LLM_PROVIDER only affects the starting point of the provider rotation.
# Providers are attempted in this order by default: OpenRouter, Groq, Cerebras, NVIDIA.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Comma-separated list of OpenRouter models.
# - openrouter/free: router that picks a free model automatically.
OPENROUTER_MODELS=openrouter/free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-120b:free
GROQ_API_KEY=
# Groq models used alongside OpenRouter.
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Cerebras OpenAI-compatible API. Leave the key empty until configured.
# Public free-tier models currently include: gpt-oss-120b, zai-glm-4.7,
# and gemma-4-31b. Check Cerebras limits before production use.
CEREBRAS_API_KEY=
CEREBRAS_MODELS=gpt-oss-120b
# NVIDIA NIM hosted free endpoints use the OpenAI-compatible API below.
# Free endpoint availability is account/model dependent; verify the model
# is marked "Free Endpoint" in the NVIDIA catalog before enabling it.
NVIDIA_API_KEY=
NVIDIA_MODELS=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=30

# Admin API Key (protects admin endpoints)
ADMIN_API_KEY=

# Cache Configuration
CACHE_TTL_STRATEGY=end_of_month_bogota

# Fallback predictor (development only)
# When enabled, the backend can fall back to the heuristic MockPredictor if both
# the primary LightGBM model and the climate analog k-NN recommender fail.
# Default: false (disabled in production).
ENABLE_MOCK_PREDICTOR=false

# Logging
# DEBUG shows step-by-step logs for every endpoint, DB query, ML inference, and LLM call.
# INFO (default) shows high-level request/response and model events.
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
MAX_REQUEST_BODY_BYTES=65536
# IP rate limiting. Enabled by default.
# ML/LLM endpoints use the stricter limit; all other HTTP requests use the general limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ML_LLM_PER_MINUTE=20
RATE_LIMIT_GENERAL_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated list of allowed frontend origins for CORS.
# Add the local network IP of the frontend if another machine accesses the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.5.121:3000

# Climate Sync Job (Open-Meteo)
ENABLE_CLIMATE_SYNC=true
CLIMATE_SYNC_HOUR=3
CLIMATE_SYNC_MINUTE=0
CLIMATE_SYNC_BATCH_SIZE=100
CLIMATE_SYNC_DELAY_SECONDS=2.0
CLIMATE_SYNC_DAYS_AHEAD=16
CLIMATE_SYNC_CLEANUP_DAYS=180

# Proxy / Forwarded headers (Uvicorn)
# Comma-separated list of trusted proxy IPs or CIDR ranges.
# In Coolify with Traefik, use the Coolify network CIDR (e.g., 172.16.1.0/24).
# Defaults to 127.0.0.1 (localhost only).
FORWARDED_ALLOW_IPS=172.16.1.0/24
